API_PORT=8081
API_ORIGIN=http://127.0.0.1:8081
CLIENT_ORIGIN=http://127.0.0.1:5173
MONGO_URL=mongodb://127.0.0.1:27017/urbatech_commerce
JWT_SECRET=change-me
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM="URBA TECH <noreply@your-verified-domain.com>"
ADMIN_NOTIFICATION_EMAILS=admin@your-domain.com,ops@your-domain.com
LOW_STOCK_THRESHOLD=3

# PayPal (sandbox/live)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=

# Payment-provider credentials must stay server-side. Konnect, Paymee and
# Flouci remain disabled until their verified API/webhook integration is added.
# Do not expose any secret in VITE_ variables or the admin browser.
KONNECT_API_KEY=
KONNECT_WEBHOOK_SECRET=
PAYMEE_API_KEY=
PAYMEE_WEBHOOK_SECRET=
FLOUCI_API_KEY=
FLOUCI_APP_TOKEN=
FLOUCI_WEBHOOK_SECRET=

# Internal reporting and supplier-settlement target currency. This does not
# change the settlement currency configured in Stripe/PayPal dashboards.
REPORTING_CURRENCY=USD

# Dynamic FX rates. Converted prices are cached, never saved on products.
EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest/USD
EXCHANGE_RATE_CACHE_MS=21600000
