API_PORT=8081
API_ORIGIN=http://127.0.0.1:8081
CLIENT_ORIGIN=http://127.0.0.1:5173
MONGO_URL=mongodb://127.0.0.1:27017/urbatech_commerce
JWT_SECRET=change-me
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM="URBA TECH <contact@your-verified-domain.com>"
EMAIL_SYSTEM_FROM="URBA TECH <noreply@your-verified-domain.com>"
ADMIN_NOTIFICATION_EMAILS=admin@your-domain.com,ops@your-domain.com
LOW_STOCK_THRESHOLD=3

# PayPal (sandbox/live)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=

# Tunisian payment gateways. All credentials remain server-side; never expose
# them in VITE_ variables or in the admin browser.
KONNECT_API_KEY=
KONNECT_RECEIVER_WALLET_ID=
# Production default: https://api.konnect.network/api/v2
KONNECT_API_BASE_URL=https://api.konnect.network/api/v2
PAYMEE_API_KEY=
# sandbox or live
PAYMEE_MODE=sandbox
FLOUCI_PUBLIC_KEY=
FLOUCI_PRIVATE_KEY=
FLOUCI_API_BASE_URL=https://developers.flouci.com/api/v2

# Internal reporting and supplier-settlement target currency. This does not
# change the settlement currency configured in Stripe/PayPal dashboards.
REPORTING_CURRENCY=USD

# Dynamic FX rates. Converted prices are cached, never saved on products.
EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest/USD
EXCHANGE_RATE_CACHE_MS=21600000
